{
  "name": "Doc Translator SaaS (Django)",
  "dockerComposeFile": ["docker-compose.yml"],
  "service": "app-dev",
  "workspaceFolder": "/workspace",
  "shutdownAction": "stopCompose",
  "remoteUser": "root",
  "forwardPorts": [8000, 5678, 5434, 6380, 5001],
  "portsAttributes": {
    "8000": { "label": "Django Web", "onAutoForward": "openBrowser" },
    "5678": { "label": "Python Debugger" },
    "5434": { "label": "PostgreSQL" },
    "6380": { "label": "Redis" },
    "5001": { "label": "LibreTranslate API" }
  },
  "postCreateCommand": "/workspace/scripts/dev-post-create.sh",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "ms-python.debugpy",
        "ms-azuretools.vscode-docker",
        "bradlc.vscode-tailwindcss",
        "esbenp.prettier-vscode",
        "charliermarsh.ruff",
        "batisteo.vscode-django",
        "tamasfe.even-better-toml",
        "redhat.vscode-yaml",
        "streetsidesoftware.code-spell-checker"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/usr/local/bin/python",
        "python.analysis.typeCheckingMode": "basic",
        "editor.formatOnSave": true,
        "files.exclude": {
          "**/__pycache__": true,
          "**/.pytest_cache": true,
          "**/.mypy_cache": true
        },
        "search.exclude": {
          "**/node_modules": true,
          "**/__pycache__": true,
          "**/.venv": true,
          "**/media/uploads": true
        }
      }
    }
  }
}
