DOC_TRANSLATOR_PORT=8010
DOC_TRANSLATOR_SECRET_KEY=change_me_secret
DOC_TRANSLATOR_DB_USER=doctranslator
DOC_TRANSLATOR_DB_PASSWORD=change_me_doctranslator
DOC_TRANSLATOR_DB_NAME=doctranslator
DOC_TRANSLATOR_ALLOWED_HOSTS=localhost,127.0.0.1
DOC_TRANSLATOR_CSRF_TRUSTED_ORIGINS=http://localhost:8010
DOC_TRANSLATOR_WEB_MEMORY_LIMIT=2G
DOC_TRANSLATOR_WEB_CPU_LIMIT=2.0

# LibreTranslate — leave empty to load ALL available language models (~40+)
DOC_TRANSLATOR_LT_LOAD_ONLY=
DOC_TRANSLATOR_LT_API_KEYS=true
DOC_TRANSLATOR_LT_REQ_LIMIT=100
DOC_TRANSLATOR_LT_CHAR_LIMIT=5000
DOC_TRANSLATOR_LIBRETRANSLATE_API_KEY=

# Ollama (runs on host machine, not in Docker)
DOC_TRANSLATOR_OLLAMA_MODEL=translategemma:4b

CORE_NETWORK=my-stack-backbone
TZ=Asia/Kolkata
